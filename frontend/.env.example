# ==============================================================================
# SEN XINH GARDEN - FRONTEND ENVIRONMENT TEMPLATE (.env.example)
# Sao chép file này thành .env để cấu hình môi trường chạy frontend
# ==============================================================================

# Bật / tắt chế độ Mock Data JSON
# - true : Sử dụng mock data từ file JSON (src/data/mockData.json)
# - false: Tắt mock data, gọi trực tiếp API Backend Spring Boot & PostgreSQL Local
VITE_USE_MOCK_DATA=true

# URL Backend API khi gọi thực tế (khi VITE_USE_MOCK_DATA=false)
VITE_API_BASE_URL=/api

# Cấu hình Google OAuth2 Client ID cho Frontend (lấy từ Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
