# ==============================================================================
# SEN XINH GARDEN - TEMPLATE ENVIRONMENT FILE (.env.example)
# Sao chép file này thành .env và điền các thông tin bí mật thực tế của bạn
# ==============================================================================

# --- Server ---
SERVER_PORT=8080

# --- Database (PostgreSQL Local) ---
DB_URL=jdbc:postgresql://localhost:5432/succulentshop
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JPA & Hibernate ---
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- Flyway Database Migration ---
FLYWAY_ENABLED=true

# --- MoMo Payment Gateway ---
MOMO_PARTNER_CODE=MOMOBKUN20180529
MOMO_ACCESS_KEY=klm05TvNBzhg7hZ8
MOMO_SECRET_KEY=at67qH6mk8w5Y1nAyMoYKMWACiEi2Aca
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/#order-success
MOMO_IPN_URL=http://localhost:8080/api/payment/momo-ipn

# --- JWT Security ---
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# --- Cloudinary (Lưu trữ ảnh sản phẩm lên Cloud) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- SePay & Chuyển Khoản Ngân Hàng (VietQR Tự Động) ---
# API Key từ https://my.sepay.vn để xác thực webhook tự động cập nhật đơn hàng sang PAID
SEPAY_API_KEY=your_sepay_api_key
# Mã ngân hàng (VCB, MB, TCB, ACB, ICB, BIDV, TPB, VPB,...)
BANK_CODE=VCB
# Số tài khoản nhận tiền
BANK_ACCOUNT_NUMBER=1028889999
# Tên chủ tài khoản (Viết hoa không dấu)
BANK_ACCOUNT_NAME=SEN XINH GARDEN

